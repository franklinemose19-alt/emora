import React, { useState, useEffect } from "react";
import PhoneMockup from "./components/PhoneMockup";
import Sidebar from "./components/Sidebar";
import { Message, MoodType, FloatingParticle, UserProfile, ThemePreset, WallpaperState } from "./types";
import { autoReplies, moods, themePresets } from "./data";

export default function App() {
  // Navigation State for the Mockup Inner View
  const [activeTab, setActiveTab] = useState<"chats" | "status" | "calls" | "communities" | "profile">("chats");

  // Custom Core Mood
  const [activeMood, setActiveMood] = useState<MoodType>("vibe");

  // App Theme state - loaded from presets or custom
  const [currentTheme, setCurrentTheme] = useState<ThemePreset>(themePresets[0]); // Start with Minimal Dark
  const [typing, setTyping] = useState(false);
  const [floatingParticles, setFloatingParticles] = useState<FloatingParticle[]>([]);

  // Wallpaper Core State
  const [currentWallpaper, setCurrentWallpaper] = useState<WallpaperState>({
    category: "Aesthetic",
    url: "https://images.unsplash.com/photo-1557683316-973673baf926?auto=format&fit=crop&q=80&w=600",
    isAnimated: true,
    reactiveEnabled: true,
    blur: 0,
    brightness: 1,
    name: "Soft Pastel Gradient"
  });

  // User profile
  const [userProfile, setUserProfile] = useState<UserProfile>({
    name: "Frankie",
    moodBio: "Era unlocked... aura farming 🚀",
    vibeStatus: "Locked In",
    avatarCombo: "🔥✨",
    animatedAvatar: true,
    auraGlow: true,
    favoriteEmojis: ["🔥", "✨", "💀", "😂", "🫠", "🫶"],
    nowPlaying: { song: "Cruel Summer", artist: "Taylor Swift" },
    streak: 12,
    auraLevel: 9400,
    badges: ["Aura Farmer", "Emoji Weaver", "Feral Master"],
    autoSyncMood: true
  });

  // Theme variable applier
  useEffect(() => {
    const root = document.documentElement;
    root.style.setProperty("--color-background", currentTheme.background);
    root.style.setProperty("--color-background-secondary", currentTheme.backgroundSecondary);
    root.style.setProperty("--color-surface", currentTheme.surface);
    root.style.setProperty("--color-text", currentTheme.text);
    root.style.setProperty("--color-text-muted", currentTheme.textMuted);
    root.style.setProperty("--color-border", currentTheme.border);
    root.style.setProperty("--color-chat-bubble-incoming", currentTheme.bubbleIn);

    if (currentTheme.isDark) {
      root.classList.add("dark");
    } else {
      root.classList.remove("dark");
    }
  }, [currentTheme]);

  // Sync avatar layout with current active mood automatically
  useEffect(() => {
    if (userProfile.autoSyncMood) {
      const moodAvatarCombos: Record<MoodType, string> = {
        vibe: "😂✨",
        chaos: "🤡🔥",
        romantic: "❤️🌹",
        sad: "😭🌧️",
        hype: "⚡💪"
      };
      setUserProfile((prev) => ({
        ...prev,
        avatarCombo: moodAvatarCombos[activeMood]
      }));
    }
  }, [activeMood, userProfile.autoSyncMood]);

  // Prime initial mock messages inside chat for great UX
  const [messages, setMessages] = useState<Message[]>([
    {
      id: "init-1",
      text: "Hey! Welcome to Emora. What's your current vibe today? 👾",
      isOutgoing: false,
      timestamp: "09:30 AM",
      isEmojiOnly: false,
      reactions: { "❤️": 1 }
    },
    {
      id: "init-2",
      text: "Honestly, main character aura farming today. 😂✨",
      isOutgoing: true,
      timestamp: "09:31 AM",
      isEmojiOnly: false,
      reactions: {}
    },
    {
      id: "init-3",
      text: "Lmao unhinged alert! I feel chaotic evil mode starting... 😈⚡",
      isOutgoing: false,
      timestamp: "09:32 AM",
      isEmojiOnly: false,
      reactions: { "🔥": 2 }
    }
  ]);

  // Function to spawn 5 floating emoji particles on tap
  const spawnEmojiParticles = (emoji: string) => {
    const freshParticles = Array.from({ length: 5 }).map((_, idx) => ({
      id: `${Date.now()}-${Math.random()}-${idx}`,
      emoji,
      x: 10 + Math.random() * 80, // % left offset
      y: 10 + Math.random() * 40,  // % bottom offset
    }));

    setFloatingParticles((prev) => [...prev, ...freshParticles]);

    // Cleanup particles with a timeout to match 1.6s fade animation
    setTimeout(() => {
      setFloatingParticles((prev) =>
        prev.filter((p) => !freshParticles.some((f) => f.id === p.id))
      );
    }, 1600);
  };

  // Primary send message workflow
  const handleSendMessage = (text: string, emojis?: string, isVoice: boolean = false, voiceDur?: string, voiceEmo?: string) => {
    const isEmojiOnly =
      !text &&
      !!emojis &&
      emojis.length <= 16 &&
      !/[a-zA-Z0-9]/.test(emojis) &&
      !/[\u4e00-\u9fa5]/.test(emojis);

    const newMessage: Message = {
      id: `msg-${Date.now()}`,
      text: text || undefined,
      emojis: emojis || undefined,
      isOutgoing: true,
      timestamp: new Date().toLocaleTimeString([], { hour: "2-digit", minute: "2-digit" }),
      isEmojiOnly,
      reactions: {},
      isVoice,
      voiceDuration: voiceDur,
      voiceEmotion: voiceEmo
    };

    setMessages((prev) => [...prev, newMessage]);

    // Spawn floating emoji particles
    if (emojis) {
      const charArray = Array.from(emojis);
      charArray.forEach((char, idx) => {
        setTimeout(() => {
          spawnEmojiParticles(char);
        }, idx * 100);
      });
    }

    // Auto replies simulation
    setTimeout(() => {
      setTyping(true);

      setTimeout(() => {
        setTyping(false);
        const moodReplies = autoReplies[activeMood];
        const randomReplyText = moodReplies[Math.floor(Math.random() * moodReplies.length)];

        const defaultPip: Record<string, number> = {};
        const activeEmojisList = moods[activeMood].emojis;
        const matchedSeedReaction = activeEmojisList[Math.floor(Math.random() * activeEmojisList.length)];
        defaultPip[matchedSeedReaction] = 1;

        const incomingMessage: Message = {
          id: `msg-incoming-${Date.now()}`,
          text: randomReplyText,
          isOutgoing: false,
          timestamp: new Date().toLocaleTimeString([], { hour: "2-digit", minute: "2-digit" }),
          isEmojiOnly: false,
          reactions: defaultPip
        };

        setMessages((prev) => [...prev, incomingMessage]);
      }, 1200);
    }, 400);
  };

  const handleUpdateReaction = (msgId: string, emoji: string) => {
    spawnEmojiParticles(emoji);

    setMessages((prev) =>
      prev.map((msg) => {
        if (msg.id === msgId) {
          const updatedReactions = { ...msg.reactions };
          updatedReactions[emoji] = (updatedReactions[emoji] || 0) + 1;
          return { ...msg, reactions: updatedReactions };
        }
        return msg;
      })
    );
  };

  const handleClearHistory = () => {
    setMessages([]);
  };

  return (
    <main className="min-h-screen bg-zinc-100 dark:bg-zinc-950 flex flex-col items-center justify-center p-2 sm:p-4 transition-colors duration-200">
      <div
        className="w-full max-w-6xl rounded-[28px] p-4 lg:p-6 flex flex-col lg:flex-row gap-6 items-center lg:items-start justify-center transition-colors duration-200 shadow-xl border select-none"
        style={{
          background: "var(--color-surface)",
          borderColor: "var(--color-border)",
        }}
      >
        {/* Left Interactive Phone Device */}
        <section className="flex justify-center shrink-0">
          <PhoneMockup
            messages={messages}
            activeMood={activeMood}
            setActiveMood={setActiveMood}
            typing={typing}
            onSendMessage={handleSendMessage}
            onUpdateReaction={handleUpdateReaction}
            floatingParticles={floatingParticles}
            spawnEmojis={spawnEmojiParticles}
            onClearChat={handleClearHistory}
            
            // Added v3 props
            activeTab={activeTab}
            setActiveTab={setActiveTab}
            currentWallpaper={currentWallpaper}
            setCurrentWallpaper={setCurrentWallpaper}
            currentTheme={currentTheme}
            userProfile={userProfile}
            setUserProfile={setUserProfile}
          />
        </section>

        {/* Right Admin Dashboard console */}
        <section className="w-full flex-1">
          <Sidebar
            activeMood={activeMood}
            setActiveMood={setActiveMood}
            onSendEmojiSequence={(emojis) => handleSendMessage("", emojis)}
            spawnEmojis={spawnEmojiParticles}
            currentTheme={currentTheme}
            onChangeTheme={setCurrentTheme}
            currentWallpaper={currentWallpaper}
            onChangeWallpaper={setCurrentWallpaper}
            userProfile={userProfile}
            onChangeProfile={setUserProfile}
          />
        </section>
      </div>
    </main>
  );
}

          </div>

          {/* SYSTEM NAVIGATION TAB BAR */}
          <div className="grid grid-cols-5 border-t py-1.5" style={{ background: currentTheme.surface, borderColor: currentTheme.border }}>
            <button onClick={() => { setActiveTab("chats"); }} className="flex flex-col items-center justify-center transition" style={{ color: activeTab === "chats" ? "#9F7AEA" : currentTheme.textMuted }}>
              <MessageSquare size={16} />
              <span className="text-[9px] font-bold mt-0.5">Chats</span>
            </button>
            <button onClick={() => { setActiveTab("status"); }} className="flex flex-col items-center justify-center transition" style={{ color: activeTab === "status" ? "#9F7AEA" : currentTheme.textMuted }}>
              <Clock size={16} />
              <span className="text-[9px] font-bold mt-0.5">Status</span>
            </button>
            <button onClick={() => { setActiveTab("calls"); }} className="flex flex-col items-center justify-center transition" style={{ color: activeTab === "calls" ? "#9F7AEA" : currentTheme.textMuted }}>
              <Phone size={16} />
              <span className="text-[9px] font-bold mt-0.5">Calls</span>
            </button>
            <button onClick={() => { setActiveTab("communities"); }} className="flex flex-col items-center justify-center transition" style={{ color: activeTab === "communities" ? "#9F7AEA" : currentTheme.textMuted }}>
              <Users size={16} />
              <span className="text-[9px] font-bold mt-0.5">Rooms</span>
            </button>
            <button onClick={() => { setActiveTab("profile"); }} className="flex flex-col items-center justify-center transition" style={{ color: activeTab === "profile" ? "#9F7AEA" : currentTheme.textMuted }}>
              <User size={16} />
              <span className="text-[9px] font-bold mt-0.5">My Tab</span>
            </button>
          </div>

        </div>
      )}

      {/* FULLSCREEN MOCK STATUS VIEWER DETAIL POPUP OVERLAY */}
      {viewingStatus && (
        <div className="absolute inset-0 bg-black/95 z-50 p-4 flex flex-col justify-between">
          {/* Progress timelines indicators */}
          <div className="flex gap-1">
            <div className="h-1 bg-white/20 grow rounded-full overflow-hidden">
              <div className="h-full bg-white transition-all" style={{ width: `${statusProgress}%` }}></div>
            </div>
          </div>

          {/* User profile metadata bar */}
          <div className="flex justify-between items-center py-2 text-white">
            <div className="flex items-center gap-2">
              <div className="w-8 h-8 rounded-full bg-white/10 flex items-center justify-center border text-base select-none">
                {viewingStatus.avatarCombo}
              </div>
              <div>
                <h5 className="text-xs font-bold">{viewingStatus.displayName}</h5>
                <span className="text-[9px] opacity-75">{viewingStatus.timestamp}</span>
              </div>
            </div>
            <button onClick={() => setViewingStatus(null)} className="p-1.5 hover:bg-white/10 rounded-full">
              <X size={15} />
            </button>
          </div>

          {/* Big custom elegant visual message */}
          <div className="flex-1 flex flex-col items-center justify-center text-center p-6 text-white select-none">
            <h2 className="text-xl px-2 font-bold leading-relaxed break-words" style={{ fontFamily: viewingStatus.font, color: viewingStatus.color }}>
              "{viewingStatus.content}"
            </h2>
            
            {viewingStatus.songName && (
              <span className="mt-4 text-[10px] bg-pink-500/25 border border-pink-400 px-3 py-1 rounded-full text-pink-200 inline-flex items-center gap-1.5">
                🎵 {viewingStatus.songName}
              </span>
            )}
          </div>

          {/* Quick Reaction Bottom Drawer */}
          <div className="space-y-2">
            <div className="grid grid-cols-6 gap-2">
              {["❤️", "😂", "😢", "😮", "🔥", "🙌"].map((emoji) => (
                <button
                  key={emoji}
                  onClick={() => {
                    spawnEmojis(emoji);
                    setViewingStatus(null);
                  }}
                  className="text-2xl hover:scale-125 transition py-1"
                >
                  {emoji}
                </button>
              ))}
            </div>
            <input
              type="text"
              placeholder="Reply to status..."
              onKeyDown={(e) => {
                if (e.key === "Enter") {
                  onSendMessage(`Replied to status: "${(e.target as HTMLInputElement).value}"`);
                  setViewingStatus(null);
                }
              }}
              className="w-full bg-white/10 border border-white/20 p-2 text-xs rounded-xl text-white outline-hidden placeholder-white/40"
            />
          </div>
        </div>
      )}

      {/* WALLPAPER PICKER CORRESPONDING BOTTOM DRAWERS SHEET */}
      {showWallpaperSheet && (
        <div className="absolute inset-x-0 bottom-0 max-h-[360px] bg-white dark:bg-zinc-900 border-t rounded-t-[24px] z-50 p-4 space-y-3 flex flex-col justify-between overflow-y-auto">
          <div className="flex justify-between items-center">
            <h4 className="text-xs font-bold text-purple-600 uppercase flex items-center gap-1">
              🎨 Choose Wallpaper Category
            </h4>
            <button onClick={() => setShowWallpaperSheet(false)} className="p-1 rounded hover:bg-zinc-100 dark:hover:bg-zinc-800">
              <X size={15} style={{ color: currentTheme.text }} />
            </button>
          </div>

          {/* Custom Wallpaper Categories Browser tabs */}
          <div className="flex gap-1.5 overflow-x-auto no-scrollbar pb-1">
            {["Anime", "Aesthetic", "Dark", "Neon", "Minimalist"].map((cat) => (
              <button
                key={cat}
                onClick={() => setActiveWallpaperTab(cat)}
                className={`px-3 py-1 text-[9.5px] font-bold rounded-full border transition shrink-0 ${activeWallpaperTab === cat ? 'bg-purple-500 text-white border-purple-500' : 'bg-zinc-50 dark:bg-zinc-800'}`}
              >
                {cat}
              </button>
            ))}
          </div>

          {/* Visual Thumbnails grid */}
          <div className="grid grid-cols-2 gap-2 overflow-y-auto max-h-[140px] py-1">
            {wallpaperPresets
              .filter((p) => p.category === activeWallpaperTab)
              .map((wall) => (
                <div
                  key={wall.id}
                  onClick={() => {
                    setCurrentWallpaper({
                      name: wall.name,
                      category: wall.category,
                      url: wall.url,
                      isAnimated: true,
                      reactiveEnabled: true,
                      blur: currentWallpaper.blur,
                      brightness: currentWallpaper.brightness,
                    });
                    spawnEmojis("🎨");
                  }}
                  className={`border rounded-xl p-2 text-left relative overflow-hidden h-14 bg-cover bg-center cursor-pointer transition active:scale-95 flex items-end ${currentWallpaper.name === wall.name ? 'border-purple-500 ring-2 ring-purple-500/25' : ''}`}
                  style={{ backgroundImage: `url('${wall.url}')` }}
                >
                  <div className="absolute inset-0 bg-black/40 z-0"></div>
                  <span className="text-[9.5px] text-white font-extrabold relative z-10 truncate block w-full">{wall.name}</span>
                </div>
              ))}
          </div>

          {/* Crop, Blurs, and brightness custom modifiers */}
          <div className="p-2 bg-zinc-50 dark:bg-zinc-800 rounded-xl space-y-1.5 border" style={{ borderColor: currentTheme.border }}>
            <div className="flex items-center justify-between text-[9px] font-bold">
              <span>Blur radius: {currentWallpaper.blur}px</span>
              <input
                type="range"
                min={0}
                max={10}
                value={currentWallpaper.blur}
                onChange={(e) => setCurrentWallpaper({ ...currentWallpaper, blur: Number(e.target.value) })}
                className="w-24 accent-purple-500 h-1 rounded"
              />
            </div>
            
            <div className="flex items-center justify-between text-[9px] font-bold">
              <span>Brightness: {currentWallpaper.brightness}</span>
              <input
                type="range"
                min={0.5}
                max={1.5}
                step={0.1}
                value={currentWallpaper.brightness}
                onChange={(e) => setCurrentWallpaper({ ...currentWallpaper, brightness: Number(e.target.value) })}
                className="w-24 accent-purple-500 h-1 rounded"
              />
            </div>
          </div>

          <button onClick={() => setShowWallpaperSheet(false)} className="w-full py-1.5 bg-zinc-950 text-white text-xs font-bold rounded-xl transition hover:opacity-90">
            Apply to Chat Workspace ✨
          </button>
        </div>
      )}

    </div>
  );
}

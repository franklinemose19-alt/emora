import React, { useState, useEffect, useRef } from "react";
import {
  Camera,
  Phone,
  Send,
  Smile,
  Keyboard,
  Trash2,
  X,
  Sparkles,
  ArrowLeft,
  Volume2,
  Mic,
  Plus,
  Play,
  Heart,
  MessageSquare,
  Users,
  Compass,
  User,
  CheckCircle,
  Clock,
  PhoneMissed,
  Video,
  Info
} from "lucide-react";
import { Message, MoodType, FloatingParticle, UserProfile, WallpaperState, ThemePreset } from "../types";
import { moods, keywordEmojiMap, initialStatuses, initialCalls, initialRooms, wallpaperPresets } from "../data";

interface PhoneMockupProps {
  messages: Message[];
  activeMood: MoodType;
  setActiveMood: (mood: MoodType) => void;
  typing: boolean;
  onSendMessage: (text: string, emojis?: string, isVoice?: boolean, voiceDur?: string, voiceEmo?: string) => void;
  onUpdateReaction: (msgId: string, emoji: string) => void;
  floatingParticles: FloatingParticle[];
  spawnEmojis: (emoji: string) => void;
  onClearChat: () => void;
  
  // Custom sync states
  activeTab: "chats" | "status" | "calls" | "communities" | "profile";
  setActiveTab: (tab: "chats" | "status" | "calls" | "communities" | "profile") => void;
  currentWallpaper: WallpaperState;
  setCurrentWallpaper: (wall: WallpaperState) => void;
  currentTheme: ThemePreset;
  userProfile: UserProfile;
  setUserProfile: React.Dispatch<React.SetStateAction<UserProfile>>;
}

export default function PhoneMockup({
  messages,
  activeMood,
  setActiveMood,
  typing,
  onSendMessage,
  onUpdateReaction,
  floatingParticles,
  spawnEmojis,
  onClearChat,

  activeTab,
  setActiveTab,
  currentWallpaper,
  setCurrentWallpaper,
  currentTheme,
  userProfile,
  setUserProfile
}: PhoneMockupProps) {
  // Input mode
  const [mode, setMode] = useState<"keyboard" | "expression">("keyboard");
  const [inputText, setInputText] = useState("");
  const [suggestions, setSuggestions] = useState<string | null>(null);
  const [suggestLoading, setSuggestLoading] = useState(false);
  const [enhancing, setEnhancing] = useState(false);

  // Wallpaper Picker Bottom Sheet Toggle
  const [showWallpaperSheet, setShowWallpaperSheet] = useState(false);
  const [activeWallpaperTab, setActiveWallpaperTab] = useState("Anime");

  // Chat navigation states
  const [activeChatThread, setActiveChatThread] = useState<"emmy" | "room" | null>(null);
  const [selectedRoomId, setSelectedRoomId] = useState<string | null>(null);

  // Status Tab States
  const [viewingStatus, setViewingStatus] = useState<any | null>(null);
  const [statusProgress, setStatusProgress] = useState(0);
  const [showStatusCreator, setShowStatusCreator] = useState(false);
  const [newStatusText, setNewStatusText] = useState("");
  const [newStatusFont, setNewStatusFont] = useState("Space Grotesk");
  const [newStatusBg, setNewStatusBg] = useState("#9F7AEA");

  // Profile Customizer states
  const [tempFirstEmoji, setTempFirstEmoji] = useState("🔥");
  const [tempSecondEmoji, setTempSecondEmoji] = useState("✨");

  // Voice recording states
  const [isRecording, setIsRecording] = useState(false);
  const [recordingSeconds, setRecordingSeconds] = useState(0);

  // Vibe Community Poll voting tracking
  const [votedRooms, setVotedRooms] = useState<Record<string, string>>({});

  const chatEndRef = useRef<HTMLDivElement>(null);
  const debounceTimerRef = useRef<NodeJS.Timeout | null>(null);
  const statusIntervalRef = useRef<NodeJS.Timeout | null>(null);

  // Auto Scroll Chat
  useEffect(() => {
    chatEndRef.current?.scrollIntoView({ behavior: "smooth" });
  }, [messages, typing, activeChatThread]);

  // Handle auto timeline progression for full-screen status views
  useEffect(() => {
    if (viewingStatus) {
      setStatusProgress(0);
      statusIntervalRef.current = setInterval(() => {
        setStatusProgress((prev) => {
          if (prev >= 100) {
            clearInterval(statusIntervalRef.current!);
            setViewingStatus(null);
            return 0;
          }
          return prev + 2;
        });
      }, 100);
    }
    return () => {
      if (statusIntervalRef.current) clearInterval(statusIntervalRef.current);
    };
  }, [viewingStatus]);

  // Voice timer simulation
  useEffect(() => {
    let timer: NodeJS.Timeout;
    if (isRecording) {
      timer = setInterval(() => {
        setRecordingSeconds((prev) => prev + 1);
      }, 1000);
    } else {
      setRecordingSeconds(0);
    }
    return () => clearInterval(timer);
  }, [isRecording]);

  // Suggest debouncer
  const handleInputChange = (e: React.ChangeEvent<HTMLInputElement>) => {
    const value = e.target.value;
    setInputText(value);

    if (debounceTimerRef.current) {
      clearTimeout(debounceTimerRef.current);
    }

    if (!value.trim()) {
      setSuggestions(null);
      return;
    }

    debounceTimerRef.current = setTimeout(async () => {
      // Check preset vocabulary map
      const lowerVal = value.toLowerCase();
      let matchedKeyword = "";
      for (const keyword of Object.keys(keywordEmojiMap)) {
        if (lowerVal.includes(keyword)) {
          matchedKeyword = keyword;
          break;
        }
      }

      if (matchedKeyword) {
        setSuggestions(keywordEmojiMap[matchedKeyword]);
        return;
      }

      // Try AI suggestions
      setSuggestLoading(true);
      try {
        const res = await fetch("/api/suggest", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ text: value, mood: activeMood }),
        });
        if (res.ok) {
          const data = await res.json();
          if (data.suggestions && data.suggestions.trim().length > 0) {
            setSuggestions(data.suggestions);
          } else {
            setSuggestions(getRandomEmojisFromMood(activeMood));
          }
        } else {
          setSuggestions(getRandomEmojisFromMood(activeMood));
        }
      } catch (err) {
        setSuggestions(getRandomEmojisFromMood(activeMood));
      } finally {
        setSuggestLoading(false);
      }
    }, 380);
  };

  const getRandomEmojisFromMood = (mood: MoodType): string => {
    const set = moods[mood].emojis;
    const shuffled = [...set].sort(() => 0.5 - Math.random());
    return shuffled.slice(0, 4).join("");
  };

  const handleSendText = () => {
    if (!inputText.trim()) return;
    onSendMessage(inputText, undefined);
    setInputText("");
    setSuggestions(null);
  };

  const handleKeyPress = (e: React.KeyboardEvent<HTMLInputElement>) => {
    if (e.key === "Enter") {
      handleSendText();
    }
  };

  const handleAiEnhanceInput = async () => {
    if (!inputText.trim() || enhancing) return;
    setEnhancing(true);
    try {
      const res = await fetch("/api/enhance", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ text: inputText, mood: activeMood }),
      });
      if (res.ok) {
        const data = await res.json();
        if (data.enhanced) {
          setInputText(data.enhanced);
          spawnEmojis("✨");
        }
      }
    } catch (err) {
      console.error(err);
    } finally {
      setEnhancing(false);
    }
  };

  const handleSendEmojiOnly = () => {
    if (!suggestions) return;
    onSendMessage("", suggestions);
    setInputText("");
    setSuggestions(null);
  };

  const handleSendBoth = () => {
    if (!suggestions) return;
    onSendMessage(inputText, suggestions);
    setInputText("");
    setSuggestions(null);
  };

  const handleEmojiTap = (emoji: string) => {
    onSendMessage("", emoji);
    spawnEmojis(emoji);
  };

  const handleVibeLabelTap = (label: string) => {
    const emojisForMood = getRandomEmojisFromMood(activeMood);
    onSendMessage(`It's giving: ${label} ${emojisForMood}`, undefined);
  };

  // Record / Send simulated voice note with emotion tags
  const startRecordingVoice = () => {
    setIsRecording(true);
  };

  const stopSendVoice = () => {
    setIsRecording(false);
    const durationStr = `0:${recordingSeconds < 10 ? '0' : ''}${recordingSeconds || 3}`;
    
    // Choose voice note label based on mood
    const voiceEmotions: Record<MoodType, string> = {
      vibe: "💅 locked-in energy",
      chaos: "👹 feral energy",
      romantic: "💖 soft romantic",
      sad: "😭 heavy heart / tired",
      hype: "⚡ hyped behavior"
    };
    
    onSendMessage("🎙️ Voice Note", undefined, true, durationStr, voiceEmotions[activeMood]);
    spawnEmojis("🎙️");
  };

  // Post dynamic status
  const handleCreateStatus = () => {
    if (!newStatusText.trim()) return;
    spawnEmojis("✨");
    setShowStatusCreator(false);
    setNewStatusText("");
  };

  const activeMoodData = moods[activeMood];

  // Helper renderer for avatars
  const renderAvatar = (avatarCombo: string, hasAura: boolean, isAnimated: boolean) => {
    const parsed = avatarCombo || "🍃";
    const animeClass = isAnimated ? "animate-bounce" : "";
    const auraStyle = hasAura
      ? { boxShadow: `0 0 12px 2px ${activeMoodData.color}` }
      : {};

    return (
      <div
        className={`w-10 h-10 rounded-full flex items-center justify-center border transition-all duration-300 relative select-none shrink-0`}
        style={{
          background: `${activeMoodData.color}25`,
          borderColor: hasAura ? activeMoodData.color : "var(--color-border)",
          ...auraStyle,
        }}
      >
        <span className={`text-[17px] ${animeClass} select-none`}>{parsed}</span>
      </div>
    );
  };

  return (
    <div id="phone-container" className="phone-mockup relative select-none flex flex-col justify-between" style={{ borderColor: currentTheme.isDark ? "#1E1E22" : "#E2E8F0" }}>
      
      {/* Top Status Bar representation */}
      <div className="w-full bg-zinc-900 text-white text-[10px] px-6 py-2.5 flex justify-between items-center font-mono select-none" style={{ background: currentTheme.surface, color: currentTheme.text, borderBottom: `0.5px solid ${currentTheme.border}` }}>
        <span className="font-semibold">{new Date().toLocaleTimeString([], {hour: "2-digit", minute: "2-digit"})}</span>
        <div className="w-24 h-4 rounded-full flex items-center justify-center bg-zinc-500/10 border border-zinc-500/20">
          <div className="w-2 h-2 bg-purple-500 rounded-full mr-1.5 animate-pulse"></div>
          <span className="text-[9px] font-bold uppercase tracking-wider text-purple-500">EMORA V3</span>
        </div>
        <div className="flex gap-1 items-center font-bold">
          <span>5G</span>
          <div className="w-4.5 h-2.5 border border-current rounded-xs p-[1px] flex items-center">
            <div className="h-full w-4/5 bg-current rounded-xs"></div>
          </div>
        </div>
      </div>

      {/* RENDER ACTIVE CHAT SCREEN */}
      {activeChatThread ? (
        <div className="flex-1 flex flex-col justify-between overflow-hidden relative">
          
          {/* Chat Header banner */}
          <div className="p-3 border-b flex justify-between items-center" style={{ borderColor: currentTheme.border, background: currentTheme.surface }}>
            <div className="flex items-center gap-2.5">
              <button onClick={() => setActiveChatThread(null)} className="p-1 hover:bg-zinc-500/10 rounded-md transition" style={{ color: currentTheme.text }}>
                <ArrowLeft size={16} />
              </button>
              
              <div className="relative">
                {activeChatThread === "emmy" ? (
                  renderAvatar("🔥✨", userProfile.auraGlow, userProfile.animatedAvatar)
                ) : (
                  <div className="w-9 h-9 rounded-full bg-purple-200 flex items-center justify-center border text-base" style={{ borderColor: currentTheme.border }}>
                    {initialRooms.find(r => r.id === selectedRoomId)?.avatarEmoji || "💬"}
                  </div>
                )}
                <span className="absolute bottom-0 right-0 w-2.5 h-2.5 bg-green-500 border-2 border-white dark:border-zinc-900 rounded-full"></span>
              </div>
              
              <div>
                <h4 className="text-[12.5px] font-bold" style={{ color: currentTheme.text }}>
                  {activeChatThread === "emmy" ? "Emmy ✨" : (initialRooms.find(r => r.id === selectedRoomId)?.name || "Vibe Room")}
                </h4>
                <span className="text-[9.5px] font-medium block" style={{ color: currentTheme.textMuted }}>
                  {activeChatThread === "emmy" ? "Feral mode auto-matching" : "Mood Community online"}
                </span>
              </div>
            </div>

            <div className="flex items-center gap-1.5">
              <button onClick={() => setShowWallpaperSheet(true)} className="px-2 py-1 text-[10px] font-bold bg-purple-500 text-white rounded-md hover:bg-purple-600 transition" title="Choose Chat Wallpaper">
                🎨 Wallpaper
              </button>
              <button className="p-1.5 hover:opacity-85 rounded-lg transition" style={{ color: currentTheme.textMuted }} onClick={() => spawnEmojis("📞")}>
                <Phone size={14} />
              </button>
              <button className="p-1.5 hover:opacity-85 rounded-lg transition" style={{ color: currentTheme.textMuted }} onClick={onClearChat} title="Clear Chat messages">
                <Trash2 size={14} />
              </button>
            </div>
          </div>

          {/* CHAT THREAD PORT WITH CUSTOM WALLPAPER AND EMOTIONAL EFFECTS */}
          <div className="flex-1 overflow-y-auto p-3.5 space-y-3 relative flex flex-col justify-between" style={{ background: currentTheme.background }}>
            
            {/* Real-time Dynamic Wallpaper Background */}
            <div
              className="absolute inset-0 pointer-events-none transition-all duration-300 z-0 bg-cover bg-center"
              style={{
                backgroundImage: `url('${currentWallpaper.url}')`,
                opacity: 0.15,
                filter: `blur(${currentWallpaper.blur}px) brightness(${currentWallpaper.brightness})`,
              }}
            />

            {/* Mood Reactive Lightweight Falling Overlays */}
            {currentWallpaper.reactiveEnabled && activeMood === "sad" && (
              <div className="absolute inset-0 z-0 overflow-hidden pointer-events-none transition-all duration-1000">
                <div className="absolute top-0 inset-x-0 bottom-0 bg-gradient-to-b from-blue-900/10 to-blue-950/20 animate-pulse"></div>
                {/* Simulated lightweight drizzle */}
                <div className="text-[9px] text-blue-400 opacity-20 absolute inset-0 select-none font-mono flex flex-wrap gap-x-12 gap-y-16 overflow-hidden">
                  {Array.from({ length: 15 }).map((_, i) => (
                    <span key={i} className="animate-bounce" style={{ animationDelay: `${i * 100}ms` }}>🌧️</span>
                  ))}
                </div>
              </div>
            )}

            {currentWallpaper.reactiveEnabled && activeMood === "romantic" && (
              <div className="absolute inset-0 z-0 overflow-hidden pointer-events-none transition-all">
                <div className="absolute inset-x-0 bottom-0 top-0 bg-radial-gradient from-pink-500/15 via-transparent to-transparent animate-pulse" style={{ animationDuration: "5s" }} />
              </div>
            )}

            {currentWallpaper.reactiveEnabled && activeMood === "chaos" && (
              <div className="absolute inset-0 z-0 overflow-hidden pointer-events-none animate-pulse" style={{ animationDuration: "1s" }}>
                <div className="absolute inset-0 bg-red-500/5 mix-blend-color-dodge"></div>
              </div>
            )}

            {/* Static Community welcome widgets inside group rooms */}
            {activeChatThread === "room" && (
              <div className="bg-white/95 dark:bg-zinc-900/95 p-3 rounded-2xl border text-center space-y-2 z-10" style={{ borderColor: currentTheme.border }}>
                <p className="text-[11px] font-medium" style={{ color: currentTheme.textMuted }}>
                  Welcome to the <strong className="text-purple-500 font-bold">{initialRooms.find(r => r.id === selectedRoomId)?.name}</strong> lobby! Cast your weekly mood signature to lock in:
                </p>
                <div className="flex gap-1 justify-center">
                  {["🔥", "💀", "😭", "❤️", "⚡"].map(voteEmoji => {
                    const roomKey = selectedRoomId || "";
                    const hasVoted = votedRooms[roomKey] === voteEmoji;
                    return (
                      <button
                        key={voteEmoji}
                        onClick={() => {
                          setVotedRooms(prev => ({ ...prev, [roomKey]: voteEmoji }));
                          spawnEmojis(voteEmoji);
                        }}
                        className={`px-3 py-1 text-xs rounded-full border transition active:scale-95 flex items-center gap-1.5 font-bold ${hasVoted ? 'bg-purple-500 text-white border-purple-500' : 'bg-zinc-50 hover:bg-zinc-100 dark:bg-zinc-800'}`}
                      >
                        <span>{voteEmoji}</span>
                        <span className="text-[10px] opacity-80">{hasVoted ? 104 : 103}</span>
                      </button>
                    );
                  })}
                </div>
              </div>
            )}

            {/* Messages container list */}
            <div className="space-y-3 z-10 flex-1 flex flex-col justify-end">
              {messages.map((msg) => {
                const isUser = msg.isOutgoing;
                
                if (msg.isEmojiOnly) {
                  return (
                    <div key={msg.id} className={`flex flex-col ${isUser ? 'items-end' : 'items-start'}`}>
                      <div className="text-3xl py-0.5 hover:scale-105 transition cursor-pointer">
                        {msg.emojis}
                      </div>
                      {/* Interaction list */}
                      <div className="flex gap-1 mt-0.5">
                        {Object.entries(msg.reactions).map(([r, c]) => (
                          <button key={r} onClick={() => onUpdateReaction(msg.id, r)} className="text-[10px] bg-white border dark:bg-zinc-800 px-1.5 py-0.5 rounded-full flex gap-1 items-center shadow-xs">
                            <span>{r}</span>
                            <span className="font-bold">{c}</span>
                          </button>
                        ))}
                      </div>
                    </div>
                  );
                }

                return (
                  <div key={msg.id} className={`flex flex-col max-w-[85%] ${isUser ? 'ml-auto items-end' : 'mr-auto items-start'}`}>
                    <div
                      className="px-3 py-2 text-xs leading-snug rounded-2xl"
                      style={{
                        background: isUser ? currentTheme.bubbleOut : currentTheme.bubbleIn,
                        color: isUser ? "#FFFFFF" : currentTheme.text,
                        border: isUser ? "none" : `0.5px solid ${currentTheme.border}`,
                        borderBottomRightRadius: isUser ? "2px" : "16px",
                        borderBottomLeftRadius: isUser ? "16px" : "2px",
                      }}
                    >
                      {msg.text && <p className="whitespace-pre-wrap">{msg.text}</p>}
                      
                      {/* Voice Note representation with waveform and emotion overlay */}
                      {msg.isVoice && (
                        <div className="flex flex-col gap-1 z-10 p-1 min-w-[140px]">
                          <div className="flex items-center gap-2">
                            <button className="w-6 h-6 rounded-full bg-purple-500 text-white flex items-center justify-center hover:bg-purple-600 transition">
                              <Play size={11} fill="white" />
                            </button>
                            {/* Waveforms indicators dynamically tinted */}
                            <div className="flex gap-1 items-center grow">
                              <span className="w-1 h-3 bg-current opacity-60 rounded-xs"></span>
                              <span className="w-1 h-5 bg-current rounded-xs"></span>
                              <span className="w-1 h-2 bg-current opacity-40 rounded-xs"></span>
                              <span className="w-1 h-6 bg-current rounded-xs animate-pulse"></span>
                              <span className="w-1 h-4 bg-current opacity-70 rounded-xs"></span>
                              <span className="w-1 h-1 bg-current opacity-30 rounded-xs"></span>
                            </div>
                            <span className="text-[9px] font-mono opacity-80">{msg.voiceDuration || "0:04"}</span>
                          </div>
                          
                          {/* Emotion overlay badge */}
                          {msg.voiceEmotion && (
                            <span className="mt-1 text-[9px] font-extrabold uppercase bg-black/15 shadow-inner px-2 py-0.5 rounded-full inline-block text-white">
                              🎙️ AI DETECTED: {msg.voiceEmotion}
                            </span>
                          )}
                        </div>
                      )}

                      {msg.emojis && !msg.isVoice && (
                        <div className="border-t border-white/20 mt-1 pt-1 font-semibold text-xs leading-none">
                          {msg.emojis}
                        </div>
                      )}
                    </div>

                    {/* Reactions action line */}
                    <div className="flex gap-1 mt-1 justify-end items-center">
                      {Object.entries(msg.reactions).map(([reaction, count]) => (
                        <button key={reaction} onClick={() => onUpdateReaction(msg.id, reaction)} className="text-[10px] bg-white border dark:bg-zinc-800 dark:border-zinc-700 px-1.5 py-0.5 rounded-full flex gap-1 items-center shadow-xs" style={{ color: currentTheme.text }}>
                          <span>{reaction}</span>
                          <span className="font-bold">{count}</span>
                        </button>
                      ))}
                    </div>
                  </div>
                );
              })}

              {typing && (
                <div className="flex items-center gap-1 mr-auto bg-zinc-200/50 dark:bg-zinc-800 px-2.5 py-1.5 rounded-full border max-w-[60px]" style={{ borderColor: currentTheme.border }}>
                  <span className="w-1 h-1 rounded-full bg-current animate-bounce" style={{ animationDelay: "0ms" }}></span>
                  <span className="w-1 h-1 rounded-full bg-current animate-bounce" style={{ animationDelay: "150ms" }}></span>
                  <span className="w-1 h-1 rounded-full bg-current animate-bounce" style={{ animationDelay: "300ms" }}></span>
                </div>
              )}
            </div>

            <div ref={chatEndRef} />
          </div>

          {/* Floating particle overlays inside chat workspace */}
          <div className="absolute inset-x-0 bottom-24 top-[150px] pointer-events-none z-50 overflow-hidden">
            {floatingParticles.map((p) => (
              <div key={p.id} className="absolute pointer-events-none text-2.5xl animate-float-particle" style={{ left: `${p.x}%`, bottom: `${p.y}%` }}>
                {p.emoji}
              </div>
            ))}
          </div>

          {/* Core suggestion matrix widget */}
          {suggestions && (
            <div className="px-2 py-1.5 border-t border-b flex flex-col gap-1 z-20" style={{ borderColor: currentTheme.border, background: currentTheme.surface }}>
              <div className="flex justify-between items-center px-1">
                <span className="text-[9.5px] uppercase tracking-wide text-purple-600 font-bold flex items-center gap-1">
                  <Sparkles size={10} /> AI Emojis Auto-Match
                </span>
                <div className="flex gap-1.5 items-center">
                  <span className="text-sm font-extrabold">{suggestions}</span>
                  <button onClick={() => setSuggestions(null)} className="p-0.5 rounded hover:bg-zinc-100 flex items-center justify-center">
                    <X size={11} style={{ color: currentTheme.text }} />
                  </button>
                </div>
              </div>
              <div className="flex gap-1.5">
                <button onClick={handleSendEmojiOnly} className="flex-1 py-1 text-[10px] font-bold rounded-lg border hover:opacity-85 transition" style={{ borderColor: currentTheme.border, background: currentTheme.background, color: currentTheme.text }}>
                  Send Emojis Only
                </button>
                <button onClick={handleSendBoth} className="flex-1 py-1 text-[10px] font-bold rounded-lg text-white hover:opacity-90 transition" style={{ backgroundColor: "#9F7AEA" }}>
                  Send Both
                </button>
              </div>
            </div>
          )}

          {/* Bottom input area with voice recorder combo */}
          <div className="p-3 border-t flex flex-col gap-2.5 z-20" style={{ borderColor: currentTheme.border, background: currentTheme.surface }}>
            
            {/* Pill Toggle keyboard/expression */}
            <div className="flex border rounded-xl overflow-hidden" style={{ borderColor: currentTheme.border }}>
              <button onClick={() => setMode("keyboard")} className="flex-1 py-1.5 text-[10.5px] font-bold flex items-center justify-center gap-1" style={{ background: mode === "keyboard" ? currentTheme.background : "transparent", color: currentTheme.text }}>
                <Keyboard size={12} /> Keyboard
              </button>
              <button onClick={() => setMode("expression")} className="flex-1 py-1.5 text-[10.5px] font-bold flex items-center justify-center gap-1" style={{ background: mode === "expression" ? currentTheme.background : "transparent", color: currentTheme.text }}>
                <Smile size={12} /> Expression
              </button>
            </div>

            {mode === "keyboard" ? (
              <div className="flex gap-1.5 items-center">
                <div className="flex-1 relative">
                  <input
                    type="text"
                    value={inputText}
                    onChange={handleInputChange}
                    onKeyDown={handleKeyPress}
